# AURA HOMES server environment template.
#
# Copy this file to server/.env, fill in your real Supabase credentials, and
# never commit server/.env.

# Transaction-mode pooler (port 6543) — used by the Prisma Client at runtime.
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Session-mode pooler (port 5432) — used by Prisma Migrate direct connections.
DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# API
PORT=3001
CLIENT_URL=http://localhost:5173

# WhatsApp recipient for booking confirmations (E.164, e.g. +919481130067).
# Leave empty until a real messaging provider is wired up.
AURA_WHATSAPP_NUMBER=

# Admin authentication (required for any /api/admin route to function).
# Set strong, unique values in production — these must be exactly what is
# configured in your hosting provider's environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string
# Optional: how long an admin session stays valid, in hours. Default 12.
ADMIN_SESSION_TTL_HOURS=12

# Property photo storage (Phase 5). Property photos are uploaded by admins and
# kept in persistent object storage.
#
# Vercel Blob (recommended, works out-of-the-box on Vercel):
#   Create a Blob store in the Vercel dashboard, then set:
BLOB_READ_WRITE_TOKEN=
# REQUIRED for real uploads. When this token is empty the server falls back to
# process-local memory storage (dev/tests only, not persistent and its URLs are
# not browser-loadable), and the image service REJECTS uploads with a clear
# message instead of storing broken `memory://` URLs in the database. Set it in
# BOTH local server/.env and the Vercel project (Settings → Environment
# Variables) so admin uploads persist and the public pages can display them.
#
# No storage credentials are ever shipped to the client or stored in the
# database.