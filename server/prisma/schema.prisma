generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id                 String                @id @default(cuid())
  slug               String                @unique
  name               String
  shortLabel         String
  description        String
  shortDescription   String
  /// Maximum sleeping capacity for the home. Kept in sync with the admin-set
  /// “max guests” of THE SPACE so booking/availability validation is unchanged.
  capacity           Int
  /// Minimum guests accepted for this home (THE SPACE capacity range).
  minGuests          Int                   @default(1)
  bedrooms           Int
  bathrooms          Int
  sqft               Int
  amenities          String[]
  accent             String
  visual             String
  location           String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  beds               Int?
  /// Price per night in integer paise (₹3,000 → 300000). Phase 5.
  pricePerNightPaise Int                   @default(300000)
  airbnbReservations AirbnbReservation[]
  blockedDates       BlockedDate[]
  bookings           Booking[]
  images             PropertyImage[]
  spaceAttributes    PropertySpaceAttribute[]

  @@index([slug])
}

/// A single admin-defined “THE SPACE” card shown on the public property page.
/// Every property owns its own ordered list; arbitrary labels/values are allowed.
model PropertySpaceAttribute {
  id         String   @id @default(cuid())
  propertyId String
  label      String
  value      String
  /// Optional icon identifier (see server/src/lib/spaceValidation.ts allowed set).
  icon       String?
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sort])
}

model Booking {
  id                 String        @id @default(cuid())
  code               String        @unique
  propertyId         String
  checkIn            DateTime      @db.Date
  checkOut           DateTime      @db.Date
  notes              String?
  status             BookingStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  guestCount         Int
  primaryPhone       String
  /// Price snapshot at booking time, in paise. Set server-side only.
  originalPricePaise Int?
  discountPaise      Int?
  finalPricePaise    Int?
  couponId           String?
  /// Denormalized coupon code snapshot so history/WhatsApp never depend on the coupon row surviving.
  couponCode         String?
  /// UPI payment state for normal AURA HOMES bookings. Set to PENDING when the
  /// customer submits their UTR; ACCEPTED/REJECTED after admin review. Kept
  /// separate from `status` so a rejected payment record stays in the ledger
  /// while the booking is simply cancelled (dates released).
  paymentStatus       PaymentStatus?
  /// Transaction reference the customer entered at payment time. Full value is
  /// only ever shown to admins and inside the WhatsApp message — never public.
  utr                 String?
  paymentSubmittedAt  DateTime?
  paymentAcceptedAt   DateTime?
  paymentRejectedAt   DateTime?
  /// Optional reason shown to the customer (tracking/confirmation) when the payment is rejected.
  rejectionMessage    String?
  property            Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestRecords        Guest[]
  coupon              Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponUsage         CouponUsage?

  @@index([propertyId, checkIn, checkOut])
  @@index([status])
  @@index([couponCode])
  @@index([paymentStatus])
}

model PropertyImage {
  id         String           @id @default(cuid())
  propertyId String
  kind       PropertyImageKind
  sort       Int              @default(0)
  /// Public, persistent object-store URL.
  url        String
  /// Provider storage key used to delete the object (never exposed publicly).
  storageKey String
  alt        String           @default("")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  property   Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, kind, sort])
  @@index([propertyId, kind])
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  discountType  CouponDiscountType
  /// FIXED → paise; PERCENTAGE → whole percent (1–100).
  discountValue Int
  maxUses       Int?
  expiresAt     DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  /// Denormalized, atomically incremented usage counter (guards maxUses under concurrency).
  uses          Int                @default(0)
  usages        CouponUsage[]
  bookings      Booking[]

  @@index([code])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  bookingId String   @unique
  usedAt    DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([couponId])
}

model Guest {
  id            String      @id @default(cuid())
  bookingId     String
  fullName      String
  aadhaarNumber String
  gender        GuestGender
  age           Int
  phone         String?
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  booking       Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model BlockedDate {
  id                  String             @id @default(cuid())
  propertyId          String
  date                DateTime           @db.Date
  reason              String?
  airbnbReservationId String?
  airbnbReservation   AirbnbReservation? @relation(fields: [airbnbReservationId], references: [id], onDelete: Cascade)
  property            Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@index([propertyId, date])
  @@index([airbnbReservationId])
}

model AirbnbReservation {
  id                String        @id @default(cuid())
  propertyId        String?
  reservationNumber String
  guestName         String
  primaryPhone      String
  checkIn           DateTime      @db.Date
  checkOut          DateTime      @db.Date
  guestCount        Int
  status            AirbnbStatus  @default(ACTIVE)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  guestRecords      AirbnbGuest[]
  property          Property?     @relation(fields: [propertyId], references: [id])
  blockedDates      BlockedDate[]

  @@index([propertyId, checkIn, checkOut])
  @@index([status])
}

model AirbnbGuest {
  id            String            @id @default(cuid())
  reservationId String
  fullName      String
  aadhaarNumber String
  gender        GuestGender
  age           Int
  createdAt     DateTime          @default(now())
  reservation   AirbnbReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

/// Global AURA HOMES contact configuration shown in the public footer.
/// A single singleton row (`id` = "single") — never per-property.
model ContactSettings {
  id          String   @id @default("single")
  email       String
  phone       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Global Direct-UPI payment configuration shown on the customer payment page.
/// A single singleton row (`id` = "single"). `qrCodeUrl` holds the active
/// public QR asset (a Vercel Blob URL after the admin uploads one); while it is
/// empty the public API falls back to the static `/qr.jpeg` asset so the
/// payment page is never left with a broken/missing QR during migration.
model PaymentSettings {
  id        String   @id @default("single")
  upiName   String
  upiId     String
  upiPhone  String
  qrCodeUrl String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageSettings {
  id             String   @id @default("single")
  visualImageUrl String   @default("")
  visualImageAlt String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum GuestGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AirbnbStatus {
  ACTIVE
  CANCELLED
}

enum PropertyImageKind {
  MAIN
  SUB1
  SUB2
  SUB3
  EXTRA
}

enum CouponDiscountType {
  FIXED
  PERCENTAGE
}

/// Direct UPI payment state for a normal booking (manual admin verification).
/// PENDING   → customer submitted a UTR, awaiting admin review (dates are held).
/// ACCEPTED  → admin confirmed the UPI transfer (dates stay held).
/// REJECTED  → admin could not verify the transfer; booking.status is set to
///             CANCELLED so availabilityService/overlapService release the dates
///             while the ledger row (with UTR) is kept for audit.
enum PaymentStatus {
  PENDING
  ACCEPTED
  REJECTED
}
